{
  "name": "Google Apps Script Tools",
  "version": "0.0.5",
  "manifest_version": 3,
  "author": "Rubén Sánchez",
  "description": "Enhanced development environment for Google Apps Script with custom themes and tools.",
  "icons": {
    "16": "resources/icons/icon16.png",
    "48": "resources/icons/icon48.png",
    "128": "resources/icons/icon128.png"
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://script.google.com/*"
      ],
      "js": [
        "extension/js/main-functions.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extension/*.*",
        "extension/js/*.*",
        "extension/js/services/*.*",
        "extension/js/components/*.*",
        "extension/html/*.html",
        "themes/*.json",
        "src/vendor/codemirror/*",
        "src/vendor/diff/*",
        "src/vendor/diff2html/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Google Apps Script Tools",
    "default_popup": "src/html/index.html",
    "default_icon": {
      "16": "resources/icons/icon16.png",
      "48": "resources/icons/icon48.png",
      "128": "resources/icons/icon128.png"
    },
    "show_matches": [
      "https://script.google.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'https://apis.google.com/' 'https://www.gstatic.com/' 'https://*.firebaseio.com' 'https://www.googleapis.com' 'https://ajax.googleapis.com'; object-src 'self'"
  },
  "permissions": [
    "declarativeContent",
    "storage",
    "sidePanel",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://apps.abacus.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.github.com/*",
    "https://github.com/login/*",
    "https://script.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "oauth2": {
    "client_id": "1013353101079-6hdb0u6ee0qqpv1h332tma9f6622etf9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/script.projects",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}